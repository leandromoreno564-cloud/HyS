server {
    listen 80;
    server_name _;
    client_max_body_size 25m;

    location /build/ {
        alias /usr/share/nginx/html/build/;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        # BACKEND_URL uses Easypanel's private service network. Keeping the
        # public frontend host avoids redirects to the backend service domain.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Easypanel terminates TLS before this container. Forward its original
        # protocol so Laravel generates HTTPS asset URLs.
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }
}

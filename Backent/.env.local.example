# Plantilla para desarrollo local. Copiar a Backent/.env (ignorado por git):
#   Copy-Item .env.local.example .env ; php artisan key:generate
APP_NAME="HyS Control"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=hys_local
DB_USERNAME=hys
DB_PASSWORD=hys_local

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
